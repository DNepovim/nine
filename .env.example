EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
EXPO_PUBLIC_POSTHOG_KEY=phc_...
# Optional. The project the analytics screen's OPEN IN POSTHOG opens; 251472 if unset.
# EXPO_PUBLIC_POSTHOG_PROJECT_ID=251472

# Not read by the app. `pnpm config:push` hands it to Supabase as the Resend SMTP
# password — see [remotes.production] in supabase/config.toml.
RESEND_API_KEY=re_...
