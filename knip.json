{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "app/**/*.{ts,tsx}",
    "workbox-config.js",
    "scripts/**/*.{js,ts}",
    "**/*.test.ts",
    "lingui.config.ts"
  ],
  "project": ["**/*.{ts,tsx}"],
  "ignoreDependencies": [
    "babel-preset-expo",
    "posthog-js",
    "@lingui/babel-plugin-lingui-macro"
  ],
  "ignore": ["**/*.web.ts", "**/*.web.tsx"]
}
