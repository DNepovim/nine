msgid "{FIRST_REACH}. Same move on the 2× button — straight to 9 again, that’s {OVERSHOOT}."
msgstr "{FIRST_REACH}. Stejný pohyb na tlačítku 2× — zase rovnou na 9, to je {OVERSHOOT}."

#: components/overlays/tutorial/lessons/swipe-lesson.tsx:56
msgid "{OVERSHOOT} is over {SWIPE_TARGET}. Clear the 1× button and land it exactly."
msgstr "{OVERSHOOT} je víc než {SWIPE_TARGET}. Vynuluj tlačítko 1× a tref to přesně."

