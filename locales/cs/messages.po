#: lib/recap-lines.ts:89
msgid "[A] and [B] split the week, [N] days to [M], and nobody else got near it."
msgstr "[A] a [B] si týden rozdělili [N]–[M] a nikdo jiný se k němu nedostal."

#: lib/recap-lines.ts:91
msgid "[A] edged it [N]–[M]. [B] was never more than a day behind."
msgstr "[A] to urval [N]–[M]. [B] nikdy nezaostal o víc než o den."

#: lib/recap-lines.ts:85
msgid "[A] held the rest of it. The other two days — [D] and [E] — went elsewhere."
msgstr "Zbytek si [A] udržel. Dvakrát to bylo jinak: [D] a [E]."

#: lib/recap-lines.ts:81
msgid "[A] lost a single day all week. [B] took [D], and nothing else."
msgstr "[A] ztratil za celý týden jediný den. [B] uspěl [D], a jinde ne."

#: lib/recap-lines.ts:78
msgid "[A] took every day but [D], when [B] turned up and took that one instead."
msgstr "[A] vzal každý den; jen [D] se objevil [B] a vzal ho místo něj."

#: lib/recap-lines.ts:72
msgid "[A] took every day of it, and never once looked like giving one back."
msgstr "[A] vzal každý jeho den a ani jednou to nevypadalo, že by nějaký vrátil."

#: lib/recap-lines.ts:84
msgid "[A] took the week bar [D] and [E], which got away."
msgstr "[A] vzal celý týden; utekl mu jen [D] a [E]."

#: lib/recap-lines.ts:75
msgid "[A] won Monday, then won everything that came after it."
msgstr "[A] vyhrál pondělí a pak vyhrál všechno, co po něm přišlo."

#: lib/recap-lines.ts:121
msgid "[BOARD] changed hands more than it usually does: [C] players took a day of it."
msgstr "[BOARD] měnila majitele častěji než obvykle — hráčů, kteří na ní urvali den: [C]."

#: lib/recap-lines.ts:111
msgid "[BOARD] never left [W]’s hands."
msgstr "[BOARD] hráči [W] ani na den neutekla."

#: lib/recap-lines.ts:116
msgid "[BOARD] was [W]’s all week, [D] aside. [O] had that one."
msgstr "[BOARD] byla celý týden hráče [W], až na jeden den — [D] ji měl [O]."

#: lib/recap-lines.ts:126
msgid "[BOARD] was the exception — [W] had that one from start to finish."
msgstr "[BOARD] byla výjimka — tu měl [W] od začátku do konce."

#: lib/recap-lines.ts:120
msgid "[BOARD] was the week’s real argument — [C] different names on it."
msgstr "[BOARD] byla ten týden skutečný spor — různých jmen na ní: [C]."

#: lib/recap-lines.ts:149
msgid "[C] all-time records changed hands. That does not usually happen in one week."
msgstr "Historické rekordy změnily majitele [C]×. To se v jednom týdnu obvykle nestává."

#: lib/recap-lines.ts:147
msgid "[C] all-time records went down, which is more than most months manage."
msgstr "Historický rekord padl [C]×, což je víc, než zvládne většina měsíců."

#: lib/recap-lines.ts:97
msgid "[C] names across [P] days, and no pattern to speak of. [A] came closest with [N]."
msgstr "Jmen: [C], odehraných dnů: [P], a žádný řád v tom. Nejblíž byl [A] — [N]×."

#: lib/recap-lines.ts:117
msgid "[W] held [BOARD] until [D], when [O] got in the way of it."
msgstr "[W] držel [BOARD] celý týden, až [D] se mu do cesty postavil [O]."

#: lib/recap-lines.ts:115
msgid "[W] owned [BOARD] — every day but [D], when [O] appeared from nowhere and took it."
msgstr "[BOARD] patřila hráči [W] každý den; jen [D] se odnikud objevil [O] a vzal mu ji."

#: lib/recap-lines.ts:110
msgid "[W] owned [MODE] — every day of it, on every difficulty that got played."
msgstr "[MODE] patřila hráči [W] — každý den a na každé obtížnosti, která se hrála."

#: lib/recap-lines.ts:143
msgid "[W] took the all-time [BOARD] record on [D], and still has it."
msgstr "[W] vzal [D] historický rekord [BOARD] a pořád ho má."

